# Copy to .env in the repository root. Never commit .env.
ENTSOE_API_KEY="replace-with-your-entsoe-token"
POSTGRES_PASSWORD="replace-with-a-local-development-password"
POSTGRES_PORT=5432
# URL-encode special characters in the password when constructing this URL.
DATABASE_URL="postgresql://saftimize:replace-with-a-local-development-password@localhost:5432/saftimize"
# Open-Meteo public non-commercial API does not require a key.
# Compose uses POSTGRES_PASSWORD and internal host postgres, not DATABASE_URL.
# Dagster UI is localhost:3000; daily electricity schedule runs at 07:00 UTC.
